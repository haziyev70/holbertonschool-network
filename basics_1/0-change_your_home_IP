#!/usr/bin/env bash
# Configures IP resolution for localhost and facebook.com in /etc/hosts

sed 's/127\.0\.0\.1/127.0.0.2/' /etc/hosts > /tmp/hosts && cat /tmp/hosts > /etc/hosts

if grep -q "facebook.com" /etc/hosts; then
    sed 's/.*facebook\.com/8.8.8.8 facebook.com/' /etc/hosts > /tmp/hosts && cat /tmp/hosts > /etc/hosts
else
    echo "8.8.8.8 facebook.com" >> /etc/hosts
fi

rm -f /tmp/hosts
