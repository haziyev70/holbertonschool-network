#!/usr/bin/env bash
# Configures /etc/hosts so that localhost resolves to 127.0.0.2 and facebook.com to 8.8.8.8

# Köhnə sətrləri silirik və yenilərini əlavə edirik
sudo sed -i '/localhost/d' /etc/hosts
sudo sed -i '/facebook.com/d' /etc/hosts

echo "127.0.0.2 localhost" | sudo tee -a /etc/hosts > /dev/null
echo "8.8.8.8 facebook.com" | sudo tee -a /etc/hosts > /dev/null#!/usr/bin/env bash
# Changes localhost to 127.0.0.2 and facebook.com to 8.8.8.8 in /etc/hosts
